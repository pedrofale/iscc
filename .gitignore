__pycache__/
dist/
build/
out/
*.egg-info/
poetry.lock
notebooks/.ipynb_checkpoints
notebooks/notebook_example/
notebooks/example_out/
.DS_Store
# built MkDocs documentation site (deployed by CI, never committed)
/site/
/_site/
.cache/
# root-level scratch/output data ONLY — anchored with a leading slash so it does NOT also catch
# the package dir `src/iscc/data/` (its new files would be silently untracked) or the committed
# `validation/data/`.
/data/
# transient raw DNA/PEtracer-reference downloads (e.g. the 406 MB Tapestri h5, 553 MB PEtracer
# .h5td) + caches — never committed. The small reduced .npz summaries ARE committed (aggregate
# per-gene autocorrelation + clone/tree stats only, ~6 KB each; like the DNA dna_ref_*.npz).
validation/data/_cache/
validation/data/**/__pycache__/
