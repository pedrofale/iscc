#!/bin/bash
# Rscript of the cardelino image (cardelino 1.8.0, R 4.4; recipe in ../images/cardelino.sh). BLAS threads:
# $CARDELINO_THREADS (default 1, for several runs side by side; a lone run can take the job's cores).
# Point ISCC_CARDELINO_RSCRIPT at this file; ISCC_TOOLS_DIR holds the images.
T=${CARDELINO_THREADS:-1}
exec apptainer exec --cleanenv -B /nobackup --env OMP_NUM_THREADS=$T --env OPENBLAS_NUM_THREADS=$T \
  "${ISCC_TOOLS_DIR:?set ISCC_TOOLS_DIR to the directory of the tool images}/cardelino.sif" /opt/conda/bin/Rscript "$@"
